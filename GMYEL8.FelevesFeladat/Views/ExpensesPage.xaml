<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GMYEL8.FelevesFeladat.ViewModels"
             x:Class="GMYEL8.FelevesFeladat.Views.ExpensesPage"
             x:DataType="viewmodel:ExpensesViewModel"
             Title="Koltsegek">

    <Grid RowDefinitions="Auto,*" Padding="10">
        
        <Button Grid.Row="0"
                Text="Uj koltseg"
                Command="{Binding AddExpenseCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                Margin="10"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Expenses}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Nincs meg koltseg rogzitve"
                           FontSize="18"
                           HorizontalOptions="Center"/>
                    <Label Text="Kattints az 'Uj koltseg' gombra!"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" 
                            Padding="10" 
                            Stroke="LightGray"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 8">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Date, StringFormat='{0:yyyy.MM.dd}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"/>
                            
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Type, StringFormat='Tipus: {0}'}"/>
                            
                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="Gray"/>
                            
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Cost, StringFormat='{0:F0} Ft'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            
                            <Button Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"
                                    Text="Torol"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ExpensesViewModel}}, Path=DeleteExpenseAsyncCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="10,5"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
