<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GMYEL8.FelevesFeladat.ViewModels"
             x:Class="GMYEL8.FelevesFeladat.Views.StatisticsPage"
             x:DataType="viewmodel:StatisticsViewModel"
             Title="Statisztikak">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Label Text="Statisztikak"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <Frame BorderColor="LightGray" 
                   CornerRadius="10"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Osszesitett adatok"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,0,0,10"/>
                    
                    <Label Text="{Binding StatisticsInfo}"
                           FontSize="14"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray" 
                   CornerRadius="10"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Atlagfogyasztas"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    
                    <Label Text="{Binding AverageConsumption, StringFormat='{0:F2} L/100km'}"
                           FontSize="32"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Primary}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray" 
                   CornerRadius="10"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Koltsegek"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    
                    <Label Text="{Binding TotalFuelCost, StringFormat='Uzemanyag: {0:F0} Ft'}"
                           FontSize="16"/>
                    
                    <Label Text="{Binding TotalExpenses, StringFormat='Egyeb: {0:F0} Ft'}"
                           FontSize="16"/>
                    
                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,5"/>
                    
                    <Label Text="{Binding TotalCost, StringFormat='Osszesen: {0:F0} Ft'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Diagramok hamarosan!"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="Gray"
                   Margin="0,20,0,0"/>

            <Button Text="Frissites"
                    Command="{Binding LoadStatisticsAsyncCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
