<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GMYEL8.FelevesFeladat.ViewModels"
             x:Class="GMYEL8.FelevesFeladat.Views.AddVehiclePage"
             x:DataType="viewmodel:AddVehicleViewModel"
             Title="Új jármű hozzáadása">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Új jármű hozzáadása"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,20,0,30"/>

            <!-- Jármű név -->
            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Jármű neve *"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Entry Text="{Binding Name}"
                           Placeholder="pl. Saját autó"
                           MaxLength="100"/>
                </VerticalStackLayout>
            </Border>

            <!-- Jármű típusa -->
            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Jármű típusa *"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Picker ItemsSource="{Binding VehicleTypes}"
                            SelectedItem="{Binding SelectedVehicleType}"
                            Title="Válassz típust">
                        <Picker.ItemDisplayBinding>
                            <Binding Converter="{StaticResource EnumToDescriptionConverter}" />
                        </Picker.ItemDisplayBinding>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Rendszám -->
            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Rendszám *"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Entry Text="{Binding LicensePlate}"
                           Placeholder="pl. ABC-123"
                           MaxLength="20"/>
                </VerticalStackLayout>
            </Border>

            <!-- Évjárat -->
            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Évjárat *"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Entry Text="{Binding Year}"
                           Keyboard="Numeric"
                           Placeholder="pl. 2020"/>
                </VerticalStackLayout>
            </Border>

            <!-- Gombok -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="Mégse"
                        Command="{Binding CancelAsyncCommand}"
                        BackgroundColor="Gray"
                        TextColor="White"/>

                <Button Grid.Column="1"
                        Text="Mentés"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"/>
            </Grid>

            <Label Text="* Kötelező mezők"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>