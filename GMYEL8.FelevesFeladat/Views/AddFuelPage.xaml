<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GMYEL8.FelevesFeladat.ViewModels"
             x:Class="GMYEL8.FelevesFeladat.Views.AddFuelPage"
             x:DataType="viewmodel:AddFuelViewModel"
             Title="Tankolás hozzáadasa">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Tankolás adatai"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <Label Text="Dátum"/>
            <DatePicker Date="{Binding Date}"
                        Format="yyyy.MM.dd"/>

            <Label Text="Üzemanyag típusa"/>
            <Picker ItemsSource="{Binding FuelTypes}"
                    SelectedItem="{Binding SelectedFuelType}"
                    Title="Válassz üzemanyag típust">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource EnumToDescriptionConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <Label Text="Megtett távolság (km)"/>
            <Entry Text="{Binding Distance}"
                   Keyboard="Numeric"
                   Placeholder="pl. 450"/>

            <Label Text="Tankolt mennyiség (L)"/>
            <Entry Text="{Binding FuelAmount}"
                   Keyboard="Numeric"
                   Placeholder="pl. 35.5"/>

            <Label Text="Ár literenként (Ft)"/>
            <Entry Text="{Binding PricePerLitre}"
                   Keyboard="Numeric"
                   Placeholder="pl. 620"/>

            <Border Stroke="LightGray" 
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="15"
                    Margin="0,10,0,0">      
                <VerticalStackLayout Spacing="10">
                    <Label Text="Extra információk (opcionális)"
                           FontSize="18"
                           FontAttributes="Bold"/>

                    <Image Source="{Binding ReceiptPhotoPath}"
                           IsVisible="{Binding ReceiptPhotoPath, Converter={StaticResource IsNotNullConverter}}" />

                    <Button Text="Blokk fotó készítése"
                            Command="{Binding TakePhotoCommand}"
                            BackgroundColor="SeaGreen"
                            TextColor="White"/>

                    <Button Text="Tankolási helyszín mentése (GPS)"
                            Command="{Binding GetLocationCommand}"
                            BackgroundColor="DodgerBlue"
                            TextColor="White"/>

                    <Label Text="{Binding LocationAddress}"
                           IsVisible="{Binding LocationAddress, Converter={StaticResource IsNotNullConverter}}"
                           FontSize="14"
                           FontAttributes="Italic"
                           TextColor="DarkSlateGray"
                           Margin="0,5,0,5"/>

                    <Button Text="📍 Megnyitás térképen"
                            Command="{Binding OpenMapCommand}"
                            IsVisible="{Binding Latitude, Converter={StaticResource IsNotNullConverter}}"
                            BackgroundColor="Orange"
                            TextColor="White"/>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="Mentés"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="Green"
                        TextColor="White"/>

                <Button Grid.Column="1"
                        Text="Mégse"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Gray"
                        TextColor="White"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
