<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GMYEL8.FelevesFeladat.ViewModels"
             x:Class="GMYEL8.FelevesFeladat.Views.AddFuelPage"
             x:DataType="viewmodel:AddFuelViewModel"
             Title="Tankolas hozzaadasa">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Tankolas adatai"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <Label Text="Datum"/>
            <DatePicker Date="{Binding Date}"
                        Format="yyyy.MM.dd"/>

            <Label Text="Megtett tavolsag (km)"/>
            <Entry Text="{Binding Distance}"
                   Keyboard="Numeric"
                   Placeholder="pl. 450"/>

            <Label Text="Tankolt mennyiseg (L)"/>
            <Entry Text="{Binding FuelAmount}"
                   Keyboard="Numeric"
                   Placeholder="pl. 35.5"/>

            <Label Text="Ar literenkent (Ft)"/>
            <Entry Text="{Binding PricePerLitre}"
                   Keyboard="Numeric"
                   Placeholder="pl. 620"/>

            <Frame BorderColor="LightGray" 
                   CornerRadius="10"
                   Padding="15"
                   Margin="0,10,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Extra funkciok"
                           FontSize="18"
                           FontAttributes="Bold"/>

                    <Button Text="Blokk foto keszitese"
                            Command="{Binding TakePhotoAsyncCommand}"
                            BackgroundColor="SeaGreen"
                            TextColor="White"/>

                    <Label Text="{Binding ReceiptPhotoPath, StringFormat='Foto: {0}'}"
                           IsVisible="{Binding ReceiptPhotoPath, Converter={StaticResource IsNotNullConverter}}"
                           FontSize="12"
                           TextColor="Green"/>

                    <Button Text="Helyzet mentese (GPS)"
                            Command="{Binding GetLocationAsyncCommand}"
                            BackgroundColor="DodgerBlue"
                            TextColor="White"/>

                    <Label Text="{Binding Latitude, StringFormat='Szelesseg: {0:F6}'}"
                           IsVisible="{Binding Latitude, Converter={StaticResource IsNotNullConverter}}"
                           FontSize="12"/>

                    <Label Text="{Binding Longitude, StringFormat='Hosszusag: {0:F6}'}"
                           IsVisible="{Binding Longitude, Converter={StaticResource IsNotNullConverter}}"
                           FontSize="12"/>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="Mentes"
                        Command="{Binding SaveAsyncCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"/>

                <Button Grid.Column="1"
                        Text="Megse"
                        Command="{Binding CancelAsyncCommand}"
                        BackgroundColor="Gray"
                        TextColor="White"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
