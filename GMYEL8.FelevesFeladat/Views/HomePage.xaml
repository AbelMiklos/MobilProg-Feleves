<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GMYEL8.FelevesFeladat.ViewModels"
             x:Class="GMYEL8.FelevesFeladat.Views.HomePage"
             x:DataType="viewmodel:HomeViewModel"
             Title="Fooldal">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="{Binding WelcomeMessage}"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,20,0,30"/>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Opacity="0.5" Radius="10" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Jarmu informacio"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    
                    <Label Text="{Binding CurrentVehicle.Name, StringFormat='Nev: {0}'}"
                           IsVisible="{Binding CurrentVehicle, Converter={StaticResource IsNotNullConverter}}"/>
                    
                    <Label Text="{Binding CurrentVehicle.Type, StringFormat='Tipus: {0}'}"
                           IsVisible="{Binding CurrentVehicle, Converter={StaticResource IsNotNullConverter}}"/>
                    
                    <Label Text="{Binding CurrentVehicle.LicensePlate, StringFormat='Rendszam: {0}'}"
                           IsVisible="{Binding CurrentVehicle, Converter={StaticResource IsNotNullConverter}}"/>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Opacity="0.5" Radius="10" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Statisztikak"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    
                    <Label Text="{Binding AverageConsumption, StringFormat='Atlagfogyasztas: {0:F2} L/100km'}"/>
                    
                    <Label Text="{Binding MonthlyCost, StringFormat='Havi koltseg: {0:F0} Ft'}"/>
                    
                    <Label Text="{Binding LastFuelRecord.Date, StringFormat='Utolso tankolas: {0:yyyy.MM.dd}'}"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="Adatok frissitese"
                    Command="{Binding LoadDataAsyncCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
