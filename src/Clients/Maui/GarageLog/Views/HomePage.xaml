<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GarageLog.ViewModels"
             x:Class="GarageLog.Views.HomePage"
             x:DataType="viewmodel:HomePageViewModel"
             Title="Főoldal">

    <ScrollView>
        <Grid Padding="20" RowSpacing="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Opacity="0.5" Radius="10" />
                </Border.Shadow>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /> 
                    </Grid.RowDefinitions>
                    
                    <Label Grid.Row="0"
                           Text="Válassz járművet"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    
                    <Picker Grid.Row="1"
                            ItemsSource="{Binding Vehicles}"
                            SelectedItem="{Binding SelectedVehicle}"
                            Title="Jármű kiválasztása">
                        <Picker.ItemDisplayBinding>
                            <MultiBinding StringFormat="{}{0} - {1}">
                                <Binding Path="Name" />
                                <Binding Path="LicensePlate" />
                            </MultiBinding>
                        </Picker.ItemDisplayBinding>
                    </Picker>
                    
                    <Button Grid.Row="2"
                            Text="+ Új jármű hozzáadása"
                            Command="{Binding AddVehicleCommand}"
                            BackgroundColor="Green"
                            TextColor="White"/>

                    <Button Grid.Row="3"
                            Text="✏️ Jármű módosítása"
                            Command="{Binding EditVehicleCommand}"
                            BackgroundColor="Orange"
                            TextColor="White"
                            IsVisible="{Binding IsVehicleSelected}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15"
                    IsVisible="{Binding IsVehicleSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Opacity="0.5" Radius="10" />
                </Border.Shadow>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <Label Grid.Row="0"
                           Text="Jármű információ"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    
                    <Label Grid.Row="1"
                           Text="{Binding SelectedVehicle.Name, StringFormat='Név: {0}'}"/>
                    
                    <Label Grid.Row="2"
                           Text="{Binding SelectedVehicle.Type, StringFormat='Típus: {0}', Converter={StaticResource EnumToDescriptionConverter}}"/>
                    
                    <Label Grid.Row="3"
                           Text="{Binding SelectedVehicle.LicensePlate, StringFormat='Rendszám: {0}'}"/>
                    
                    <Label Grid.Row="4"
                           Text="{Binding SelectedVehicle.Year, StringFormat='Évjárat: {0}'}"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15"
                    IsVisible="{Binding IsVehicleSelected}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Opacity="0.5" Radius="10" />
                </Border.Shadow>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <Label Grid.Row="0"
                           Text="Statisztikák"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    
                    <Label Grid.Row="1"
                           Text="{Binding AverageConsumption, StringFormat='Átlagfogyasztás: {0:F2} L/100km'}"/>
                    
                    <Label Grid.Row="2"
                           Text="{Binding MonthlyCost, StringFormat='Havi költség: {0:F0} Ft'}"/>
                    
                    <Label Grid.Row="3"
                           Text="{Binding LastFuelRecord.Date, StringFormat='Utolsó tankolás: {0:yyyy.MM.dd}'}"
                           IsVisible="{Binding LastFuelRecord, Converter={StaticResource IsNotNullConverter}}"/>
                    
                    <Label Grid.Row="4"
                           Text="Még nincs tankolási adat"
                           IsVisible="{Binding LastFuelRecord, Converter={StaticResource IsNotNullConverter}, ConverterParameter=Invert}"
                           FontFamily="Italic"
                           TextColor="Gray"/>
                    
                    <Button Grid.Row="5"
                            Text="📊 Részletes statisztikák"
                            Command="{Binding NavigateToStatisticsCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="3"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  IsVisible="{Binding IsVehicleSelected}">
                
                <Button Grid.Column="0"
                        Text="⛽ Tankolások"
                        Command="{Binding NavigateToFuelRecordsCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"/>
                
                <Button Grid.Column="1"
                        Text="💰 Kiadások"
                        Command="{Binding NavigateToExpensesCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"/>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
