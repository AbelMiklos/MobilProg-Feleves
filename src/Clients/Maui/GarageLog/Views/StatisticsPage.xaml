<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GarageLog.ViewModels"
             x:Class="GarageLog.Views.StatisticsPage"
             x:DataType="viewmodel:StatisticsViewModel"
             Title="Statisztikák">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Border Stroke="LightGray" 
                    StrokeShape="RoundRectangle 10"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Összesített adatok"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,0,0,10"/>
                    
                    <Label Text="{Binding StatisticsInfo}"
                           FontSize="14"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="LightGray" 
                    StrokeShape="RoundRectangle 10"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Átlagfogyasztás"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    
                    <Label Text="{Binding AverageConsumption, StringFormat='{0:F2} L/100km'}"
                           FontSize="32"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Primary}"/>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="LightGray" 
                    StrokeShape="RoundRectangle 10"
                    Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Költségek"
                           FontSize="18"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding TotalFuelCost, StringFormat='Üzemanyag: {0:F0} Ft'}"
                           FontSize="16"/>

                    <Label Text="{Binding AverageFuelPricePerLitre, StringFormat='Átlagos literenkénti ár: {0:F0} Ft/L'}"
                           FontSize="14"
                           TextColor="Gray"/>

                    <Label Text="{Binding AverageMonthlyFuelCost, StringFormat='Átlagos havi üzemanyag költség: {0:F0} Ft/hó'}"
                           FontSize="14"
                           TextColor="Gray"/>

                    <Label Text="{Binding TotalExpenses, StringFormat='Összes egyéb kiadási költség: {0:F0} Ft'}"
                           FontSize="16"/>

                    <VerticalStackLayout Spacing="1" Margin="0,10,0,0">
                        <Label Text="Egyéb kiadások részletesen:"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="Gray"
                               IsVisible="{Binding HasExpenseGroups}"/>

                        <Label Text="Nincs egyéb kiadás"
                               FontSize="14"
                               TextColor="Gray"
                               IsVisible="{Binding HasExpenseGroups, Converter={StaticResource InvertedBoolConverter}}"/>

                        <CollectionView ItemsSource="{Binding ExpenseGroups}"
                                      SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:ExpenseGroupModel">
                                    <Grid ColumnDefinitions="*,Auto" Padding="10,5">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="5">
                                            <Label Text="•" 
                                                   FontSize="14"
                                                   VerticalOptions="Center"/>
                                            <Label Text="{Binding Type, Converter={StaticResource EnumToDescriptionConverter}}"
                                                   FontSize="14"
                                                   VerticalOptions="Center"/>
                                            <Label Text="{Binding Count, StringFormat='({0} db)'}"
                                                   FontSize="12"
                                                   TextColor="Gray"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="{Binding TotalCost, StringFormat='{0:F0} Ft'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,5"/>

                    <Label Text="{Binding TotalCost, StringFormat='Összesen: {0:F0} Ft'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
