<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GarageLog.ViewModels"
             x:Class="GarageLog.Views.ExpensesPage"
             x:DataType="viewmodel:ExpensesViewModel"
             x:Name="ThisPage"
             Title="Kiadások">

    <Grid RowDefinitions="Auto,*" Padding="10">
        
        <Button Grid.Row="0"
                Text="Új kiadás"
                Command="{Binding AddExpenseCommand}"
                BackgroundColor="Green"
                TextColor="White"
                Margin="10"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Expenses}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Nincs még kiadás rögzítve"
                           FontSize="18"
                           HorizontalOptions="Center"/>
                    <Label Text="Kattints az 'Új kiadás' gombra!"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodel:Expense">
                    <Border Margin="5" 
                            Padding="10" 
                            Stroke="LightGray"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 8">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Date, StringFormat='{0:yyyy.MM.dd}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"/>

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Type, Converter={StaticResource EnumToDescriptionConverter}, StringFormat='Típus: {0}'}"/>

                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="Gray"/>
                            
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Cost, StringFormat='{0:F0} Ft'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"
                                                   VerticalOptions="Center"
                                                   Spacing="5">
                                <Button Text="Részletek"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditExpenseCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Orange"
                                        TextColor="White"
                                        FontSize="12"
                                        Padding="10,5"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
