<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:GMYEL8.FelevesFeladat.ViewModels"
             xmlns:entities="clr-namespace:GMYEL8.FelevesFeladat.Domain.Entities;assembly=GMYEL8.FelevesFeladat.Domain"
             x:Class="GMYEL8.FelevesFeladat.Views.FuelRecordsPage"
             x:DataType="viewmodel:FuelRecordsViewModel"
             x:Name="ThisPage"
             Title="Tankolások">

    <Grid RowDefinitions="Auto,*" Padding="10">
        
        <Button Grid.Row="0"
                Text="Új tankolás"
                Command="{Binding AddFuelRecordCommand}"
                BackgroundColor="Green"
                TextColor="White"
                Margin="10"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FuelRecords}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Nincs még tankolás rögzítve"
                           FontSize="18"
                           HorizontalOptions="Center"/>
                    <Label Text="Kattints az 'Új tankolás' gombra!"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:FuelRecord">
                    <Border Margin="5" 
                            Padding="10" 
                            Stroke="LightGray">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Date, StringFormat='{0:yyyy.MM.dd}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"/>
                            
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Type, Converter={StaticResource EnumToDescriptionConverter}, StringFormat='Típus: {0}'}"/>
                            
                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding Distance, StringFormat='Távolság: {0} km'}"/>
                            
                            <Label Grid.Row="3" Grid.Column="0"
                                   Text="{Binding FuelAmount, StringFormat='Mennyiség: {0} L'}"/>
                            
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding TotalCost, StringFormat='{0:F0} Ft'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.RowSpan="3"
                                                   VerticalOptions="Center"
                                                   Spacing="5">
                                <Button Text="Részletek"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditFuelRecordCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Orange"
                                        TextColor="White"
                                        FontSize="12"
                                        Padding="10,5"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
